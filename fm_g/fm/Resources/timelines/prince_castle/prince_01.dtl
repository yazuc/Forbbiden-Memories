[style name="New_File"]
[background arg="res://assets/background/Background_01_Pointer_F7_05_01_00_.png" fade="0.0"]
join simon left [animation="Slide From Left"]
if {Story.DuelSimon} == true:
	jump prince_03/
simon: Prince. You've returned...
simon: It is well into the night... Please return to the palace.
simon: Dear prince... If you still wish to play cards...
simon: ...then try your hand against me.
simon: If you lose, you must return to your room.
simon: I'm sure you'll finde me a worthy opponent.
- <Duel>
	set {DeckIndex} = 1.0
	simon: Ho ho ho. My dear prince... I taught you the game.
	simon: You don't really think you're going to win, do you?
	simon: Prepare yourself!!
	set {Dialogue} = "res://Resources/timelines/prince_castle/prince_02.dtl"
	set {Label} = "SimonLost"
	set {Story.DuelSimon} = true
	jump IniciarDuelo/StartDuel
- <Pass>